# Copy this file to .env.local and fill in real values.
# See docs/walkthrough-for-developer.md Section 4 for where to get each one.

# Postgres connection string. Provisioned through Vercel's Storage/marketplace
# tab (Neon), not a separate neon.tech account — see docs/project-overview.md
# Section 6 and Section 10.
DATABASE_URI=postgresql://127.0.0.1:5432/terrace-and-title

# A long, random string Payload uses to encrypt admin sessions.
# Generate your own for local dev — do not reuse the production value.
PAYLOAD_SECRET=

# Cloudflare R2 (photo/document storage) — not needed until PBI-005.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Resend (transactional email) — not needed until PBI-006.
RESEND_API_KEY=
